# ======================================================
# Twatter Deployment Configuration
# Copy this to .env and fill in your values
# ======================================================

# --- Your domain ---
CLIENT_URL=https://twatter.com
MEDIA_BASE_URL=https://media.twatter.com
RELAY_CONTACT=admin@twatter.com

# --- Lightning Payments (Alby Hub — self-custodial) ---
# Alby Hub runs as a Docker service alongside your stack.
# On first launch, open http://your-server:8080 to set up Alby Hub.
# The password you choose during setup goes here:
ALBYHUB_URL=http://albyhub:8080
ALBYHUB_PASSWORD=your_albyhub_password_here

# --- Nostr Wallet Connect (required for payments) ---
# After setting up Alby Hub, go to Settings > Connections > + New connection
# Copy the NWC URL (starts with nostr+walletconnect://)
NWC_URL=

# --- Pro Subscription ---
PRO_PRICE_USD=5.00
PRO_PRICE_SATS=0
PRO_DURATION_DAYS=30

# --- Zap Fee ---
ZAP_FEE_PERCENT=2.0
